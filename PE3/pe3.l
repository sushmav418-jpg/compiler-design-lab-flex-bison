%{
#include "pe3.tab.h"   /* generated by bison */
#include <string.h>
%}

%option noyywrap
%option yylineno

ID      [a-zA-Z_][a-zA-Z0-9_]*
DIGIT   [0-9]+

%%

"int"       { return TINT;      }
"float"     { return TFLOAT;    }
"char"      { return TCHAR;     }
"double"    { return TDOUBLE;   }
"short"     { return TSHORT;    }
"long"      { return TLONG;     }
"void"      { return TVOID;     }
"static"    { return TSTATIC;   }
"extern"    { return TEXTERN;   }
"auto"      { return TAUTO;     }
"register"  { return TREGISTER; }
"return"    { return TRETURN;   }
"if"        { return TIF;       }
"else"      { return TELSE;     }
"while"     { return TWHILE;    }
"for"       { return TFOR;      }

{DIGIT}     { yylval.ival = atol(yytext); return INT_LITERAL; }

{ID}        { strncpy(yylval.sval, yytext, 63); return IDENTIFIER; }

"=="        { return EQ;     }
"!="        { return NEQ;    }
"<="        { return LE;     }
">="        { return GE;     }
"<"         { return LT;     }
">"         { return GT;     }
"&&"        { return AND;    }
"||"        { return OR;     }
"!"         { return NOT;    }
"="         { return ASSIGN; }
"+"         { return PLUS;   }
"-"         { return MINUS;  }
"*"         { return STAR;   }
"/"         { return SLASH;  }
"%"         { return PERCENT;}
";"         { return SEMI;   }
"{"         { return LBRACE; }
"}"         { return RBRACE; }
"("         { return LPAREN; }
")"         { return RPAREN; }
","         { return COMMA;  }

[ \t\n\r]+  { /* skip whitespace */ }
"//".*      { /* skip line comments */ }
.           { /* ignore unknown chars */ }

%%
